<UserControl x:Class="CADCanvas.SubSystem.EditerSystem.Control.PointPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CADCanvas.SubSystem.EditerSystem.Control"
             mc:Ignorable="d" FontFamily="新宋体" HorizontalAlignment="Left" VerticalAlignment="Top"
             Height="25">
    <Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
            <Border Background="#2b2b2b" BorderThickness="1" BorderBrush="#5b5b5b">
                <Label Foreground="White" Content="指定第一个点：" Padding="0" VerticalAlignment="Center" FontSize="12" Margin="6,0"/>
            </Border>
            <Border Background="#2b2b2b" BorderThickness="1" BorderBrush="#464646" Margin="10,0,0,0">
                <Label Foreground="White" Content="X" Padding="0" VerticalAlignment="Center" FontSize="12" Margin="6,0"/>
            </Border>
            <Grid Margin="-1,0,0,0" Width="80">
                <TextBox x:Name="Input_x"/>
                <Image x:Name="Lock_x" Source="Image/Lock.png" Width="11" Height="11" HorizontalAlignment="Right" Margin="0,0,6,0" Visibility="Collapsed"/>
            </Grid>
            <Border Background="#2b2b2b" BorderThickness="1" BorderBrush="#464646" Margin="10,0,0,0">
                <Label Foreground="White" Content="Y" Padding="0" VerticalAlignment="Center" FontSize="12" Margin="6,0"/>
            </Border>
            <Grid Margin="-1,0,0,0" Width="80">
                <TextBox x:Name="Input_y"/>
                <Image x:Name="Lock_y" Source="Image/Lock.png" Width="11" Height="11" HorizontalAlignment="Right" Margin="0,0,6,0" Visibility="Collapsed"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>