<UserControl x:Class="CADCanvas.SubSystem.EditerSystem.Control.LineInfoPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CADCanvas.SubSystem.EditerSystem.Control"
             mc:Ignorable="d" IsHitTestVisible="False" FontFamily="新宋体"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid x:Name="LayerBox"></Grid>
        <Canvas>
            <!-- 长度 -->
            <Grid x:Name="Grid_Length" Canvas.Left="10" Canvas.Top="10" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <!-- 标签 -->
                <Border Background="#2b2b2b" BorderThickness="1" BorderBrush="#464646" Visibility="Collapsed">
                    <Label Foreground="White" Content="长度" Padding="0" VerticalAlignment="Center" FontSize="12" Margin="6,0"/>
                </Border>
                <Grid Margin="0,0,0,0" Width="100" Height="25" Grid.Column="1">
                    <!-- 输入框 -->
                    <TextBox x:Name="Input_Length"/>
                    <!-- 锁 -->
                    <Image x:Name="Lock_Length" Source="Image/Lock.png" Width="11" Height="11" HorizontalAlignment="Right" Margin="0,0,6,0" Visibility="Collapsed"/>
                </Grid>
            </Grid>
            <!-- 角度 -->
            <Grid x:Name="Grid_Angle" Canvas.Left="10" Canvas.Top="45" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <!-- 标签 -->
                <Border Background="#2b2b2b" BorderThickness="1" BorderBrush="#464646" Visibility="Collapsed">
                    <Label Foreground="White" Content="角度" Padding="0" VerticalAlignment="Center" FontSize="12" Margin="6,0"/>
                </Border>
                <Grid Margin="0,0,0,0" Width="80" Height="25" Grid.Column="1">
                    <!-- 输入框 -->
                    <TextBox x:Name="Input_Angle"/>
                    <!-- 锁 -->
                    <Image x:Name="Lock_Angle" Source="Image/Lock.png" Width="11" Height="11" HorizontalAlignment="Right" Margin="0,0,6,0" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Canvas>
    </Grid>
</UserControl>