<UserControl x:Class="XLogic.WpfControl.InfoBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:XLogic.WpfControl"
             mc:Ignorable="d" FontFamily="新宋体">
    <TextBlock Margin="0,-1,0,-2">
    <Run x:Name="Title" Text="信息标题：" Foreground="White"/>
    <Run x:Name="Info" Text="信息内容" Foreground="White"/>
    </TextBlock>
</UserControl>
